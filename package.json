{
  "name": "smart-library-management-system",
  "type": "module",
  "version": "1.0.0",
  "description": "A modern full-stack Library Management System developed as a Third-Year CSE Project-Based Learning (PBL) project.",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "build": "npm run build --prefix frontend",
