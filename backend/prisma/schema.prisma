generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int     @id @default(autoincrement())
  roleName    String  @unique
  description String?

  users User[]

  @@map("roles")
}

model User {
  id String @id @default(uuid())

  fullName String

  email String @unique

  passwordHash String

  roleId Int

  role Role @relation(fields: [roleId], references: [id])

  studentProfile StudentProfile?

  librarianProfile LibrarianProfile?

  studentLoans Loan[] @relation("LoanStudent")
  issuedLoans  Loan[] @relation("LoanIssuer")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("users")
}

model StudentProfile {
  id Int @id @default(autoincrement())

  userId String @unique

  enrollmentNo String @unique

  department String

  semester Int

  year Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model LibrarianProfile {
  id Int @id @default(autoincrement())

  userId String @unique

  employeeId String @unique

  designation String

  phone String?

  address String?

  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("librarian_profiles")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  books       Book[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Book {
  id              String   @id @default(uuid())
  isbn            String   @unique
  title           String
  author          String
  publisher       String?
  publicationYear Int?
  shelfLocation   String?
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  isActive        Boolean  @default(true)
  categoryId      Int
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  loans           Loan[]

  @@index([title])
  @@index([author])
  @@index([categoryId])
  @@map("books")
}


model Loan {
  id            String   @id @default(uuid())
  studentUserId String
  bookId        String
  issuedById    String
  issuedAt      DateTime @default(now())
  dueDate       DateTime
  returnedAt    DateTime?
  fineAmount    Int      @default(0)
  student       User     @relation("LoanStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  book          Book     @relation(fields: [bookId], references: [id], onDelete: Restrict)
  issuedBy      User     @relation("LoanIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  @@index([studentUserId, returnedAt])
  @@index([bookId, returnedAt])
  @@index([dueDate, returnedAt])
  @@map("loans")
}
